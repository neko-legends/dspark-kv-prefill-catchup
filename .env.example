# Copy to .env on the head node. Do not commit a filled copy.

NNODES=4
HEAD_HOST=node0
WORKER_HOSTS=node1,node2,node3
MASTER_ADDR=192.168.2.1
MASTER_PORT=25000

NODE0_IP=192.168.2.1
NODE1_IP=192.168.2.2
NODE2_IP=192.168.2.3
NODE3_IP=192.168.2.4

NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_ADDR_RANGE=192.168.2.0/24
NCCL_CROSS_NIC=1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN

DSPARK_VLLM_IMAGE=dspark-vllm-gx10:0.1.1-flashinfer-0.6.15
DSPARK_MODEL=/models/abliterated-nvfp4
DSPARK_MODEL_HOST=/path/to/keys-deepseek-v4-flash-ga-0731-dspark-abliterated-32-32
SERVED_MODEL_NAME=deepseek-v4-flash-0731-ablit-32-32
VLLM_HOST=0.0.0.0
VLLM_PORT=18888
VLLM_HOST_IP=192.168.2.1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

MAX_MODEL_LEN=393216
MAX_NUM_SEQS=12
MAX_NUM_BATCHED_TOKENS=8264
MAX_CUDAGRAPH_CAPTURE_SIZE=96
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=7
DEFAULT_THINKING=off
VLLM_USE_BREAKABLE_CUDAGRAPH=0
MOE_BACKEND=flashinfer_b12x

PROJECT_NAME=deepseek-v4-flash-tp4

# Catch-up sidecar (run on the harness host).
CATCHUP_LISTEN=127.0.0.1:18900
CATCHUP_VLLM_URL=http://HEAD:18888/v1
CATCHUP_MODEL=deepseek-v4-flash-0731-ablit-32-32
CATCHUP_MAX_CONTEXT=1000000
CATCHUP_TIMEOUT_S=1800
